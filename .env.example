PORT=5000

MONGODB_URI=mongodb://localhost:27017/video-share

FRONTEND_URL=

# Comma-separated CORS origins. Link generation uses https://mastplayer.in when listed.
# Example: https://mastplayer.in,https://www.mastplayer.in,http://localhost:5173

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
# Optional — use pub-xxx.r2.dev or custom domain. If empty, playback uses presigned URLs.
R2_PUBLIC_URL=

MAX_VIDEO_SIZE_MB=2048

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

UPLOAD_RATE_LIMIT_MAX=20
SHARE_RATE_LIMIT_MAX=200
DELETE_RATE_LIMIT_MAX=50

NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=30

# Google Sign-In (OAuth client IDs from Google Cloud Console)
# Web client ID is required for GIS on mastplayer.in; also accept Android/iOS tokens.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Analytics
ANALYTICS_RATE_LIMIT_MAX=120

# App view counting (Phase 3)
VIEW_COUNTED_SECONDS=5
VIEW_PAYABLE_SECONDS=60
VIEW_USD_PER_1000=1
VIEW_RATE_LIMIT_MAX=60

# Referral program (Model 1 — bonus; referred creator keeps 100%)
REFERRAL_ENABLED=1
REFERRAL_COMMISSION_RATE=0.10

# OG Earn — remapped links (90% link owner / 10% original creator)
OG_EARN_ENABLED=1
OG_EARN_ROYALTY_RATE=0.10
OG_EARN_CONVERT_RATE_LIMIT_MAX=30

# Manual payouts (creator request → admin marks paid)
PAYOUT_MIN_USD=5

# Telegram group bot (long polling — start only in the API process)
# Do NOT put TELEGRAM_BOT_TOKEN in any frontend/Vite/React env.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_USERNAME=@Beauty_65Bot
TELEGRAM_CONNECT_CODE_TTL_MINUTES=10
TELEGRAM_DELETE_LINKS=true
TELEGRAM_SEARCH_ENABLED=true
TELEGRAM_SEARCH_LIMIT=5
# Optional comma-separated group chat IDs (empty = any group where bot is admin)
# Example: TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
TELEGRAM_ALLOWED_CHAT_IDS=
